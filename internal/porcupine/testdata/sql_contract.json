  "tables": [
    {
      "columns": [
        {
          "description": "Durable event ID, returned as a decimal string.",
          "name": "id",
          "type": "BIGINT"
        },
        {
          "description": "Stable event identifier within the project.",
          "name": "uuid",
          "type": "VARCHAR"
        },
        {
          "description": "Owning project, isolated in a separate analytical catalog.",
          "name": "project_id",
          "type": "VARCHAR"
        },
        {
          "description": "Event name.",
          "name": "event",
          "type": "VARCHAR"
        },
        {
          "description": "Canonical input category.",
          "name": "event_type",
          "type": "VARCHAR"
        },
        {
          "description": "Authenticated producer namespace.",
          "name": "source_id",
          "type": "VARCHAR"
        },
        {
          "description": "Original producer message ID.",
          "name": "message_id",
          "type": "VARCHAR"
        },
        {
          "description": "Actor identifier captured with the event.",
          "name": "distinct_id",
          "type": "VARCHAR"
        },
        {
          "description": "Current resolved project-local person.",
          "name": "person_id",
          "type": "VARCHAR"
        },
        {
          "description": "Current traits encoded as JSON.",
          "name": "person_properties",
          "type": "VARCHAR"
        },
        {
          "description": "Custom JSON properties; use json_extract_string or JSON casts.",
          "name": "properties",
          "type": "VARCHAR"
        },
        {
          "description": "Canonical JSON context: page.url, page.referrer, browser.name, browser.version, device.type, os.name, locale and session_id when supplied. Use json_extract_string(context,'$.browser.name').",
          "name": "context",
          "type": "VARCHAR"
        },
        {
          "description": "Original occurrence time in UTC RFC3339.",
          "name": "timestamp",
          "type": "VARCHAR"
        },
        {
          "description": "Original occurrence time for temporal SQL.",
          "name": "event_time",
          "type": "TIMESTAMP WITH TIME ZONE"
        },
        {
          "description": "Original occurrence time in Unix milliseconds.",
          "name": "timestamp_ms",
          "type": "BIGINT"
        },
        {
          "description": "Server receipt time in UTC RFC3339.",
          "name": "received_at",
          "type": "VARCHAR"
        },
        {
          "description": "Server receipt time in Unix milliseconds.",
          "name": "received_at_ms",
          "type": "BIGINT"
        },
        {
          "description": "Current revision for compare-and-swap mutations.",
          "name": "revision",
          "type": "UBIGINT"
        },
        {
          "description": "1 for historical imports; 0 for live ingestion.",
          "name": "is_imported",
          "type": "UTINYINT"
        }
      ],
      "name": "events"
    }
  ]
}
