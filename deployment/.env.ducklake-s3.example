# Keep the populated file private and outside Git. Use a fresh native data volume.
PORCUPINE_DUCKLAKE_S3_BUCKET=YOUR_PRIVATE_BUCKET
PORCUPINE_DUCKLAKE_S3_PREFIX=porcupine
PORCUPINE_DUCKLAKE_S3_REGION=eu-west-3
# Empty uses the regional AWS endpoint. S3-compatible services can use HTTPS:
PORCUPINE_DUCKLAKE_S3_ENDPOINT=
PORCUPINE_DUCKLAKE_S3_PATH_STYLE=false
# Empty explicit keys use the AWS credential chain (IAM/environment/profile).
PORCUPINE_DUCKLAKE_S3_ACCESS_KEY_ID=
PORCUPINE_DUCKLAKE_S3_SECRET_ACCESS_KEY=
PORCUPINE_DUCKLAKE_S3_SESSION_TOKEN=
