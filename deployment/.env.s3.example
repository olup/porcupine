# Add these operator settings to the deployment environment, then use compose.s3.yaml.
# Use an existing bucket and a unique prefix; bucket creation is outside this app.
PORCUPINE_S3_ENDPOINT=https://your-bucket.s3.eu-west-3.amazonaws.com/porcupine-data/
AWS_REGION=eu-west-3
# Set credentials through your secret manager, or leave unset for IAM credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
PORCUPINE_CLICKHOUSE_STORAGE_POLICY=hot_cold
PORCUPINE_HOT_STORAGE_DAYS=30
PORCUPINE_CLICKHOUSE_COLD_VOLUME=cold
