# Generate locally: openssl rand -hex 32. Keep private; never put in frontend code.
# Required to initialize an empty database. Existing credentials survive restarts.
PORCUPINE_BOOTSTRAP_TOKEN=
PORCUPINE_ADDR=127.0.0.1:8080
PORCUPINE_DB=./data/porcupine.db
# Optional exact hot receipt cache (0 keeps the full local ledger).
PORCUPINE_HOT_RECEIPT_LIMIT=0
PORCUPINE_QUEUE_MAX_EVENTS=100000
# Global pending original-event payload budget in bytes, separate from SQLite disk overhead.
PORCUPINE_QUEUE_MAX_BYTES=268435456
# Exact browser origins allowed for ingestion; empty disables cross-origin browser ingestion.
PORCUPINE_ALLOWED_ORIGINS=

# Only IPs/CIDRs of controlled reverse proxies; empty ignores forwarded headers.
PORCUPINE_TRUSTED_PROXIES=

# Optional for make run; Docker Compose connects to its private ClickHouse service.
PORCUPINE_CLICKHOUSE_URL=
PORCUPINE_CLICKHOUSE_DATABASE=porcupine
PORCUPINE_CLICKHOUSE_USER=porcupine_admin
# Required for Docker Compose. Generate a private random secret.
PORCUPINE_CLICKHOUSE_PASSWORD=

# Operator-only native cold storage. Empty policy keeps the existing deployment policy.
# Enable using compose.s3.yaml after configuring the ClickHouse S3 disk.
PORCUPINE_CLICKHOUSE_STORAGE_POLICY=
PORCUPINE_HOT_STORAGE_DAYS=30
PORCUPINE_CLICKHOUSE_COLD_VOLUME=cold
