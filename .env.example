# Generate locally: openssl rand -hex 32. Keep private; never put in frontend code.
# Required to initialize an empty database. Existing credentials survive restarts.
PORCUPINE_BOOTSTRAP_TOKEN=
PORCUPINE_ADDR=127.0.0.1:8080
PORCUPINE_DB=./data/porcupine.db
# Direct native server: default data directory is beside PORCUPINE_DB.
# The container keeps this fixed at /data/ducklake inside its persistent volume.
# PORCUPINE_DUCKLAKE_DIR=./data/ducklake
# Native resource controls. Memory is shared by each project engine, not a hard RSS cap.
# PORCUPINE_DUCKLAKE_MEMORY_MB=512
# PORCUPINE_DUCKLAKE_THREADS=2
# PORCUPINE_DUCKLAKE_MAX_OPEN_PROJECTS=4
# PORCUPINE_DUCKLAKE_MAINTENANCE_INTERVAL=2s
# Full receipt history is required for DuckLake. Optional ClickHouse deployments may cap this ledger.
PORCUPINE_HOT_RECEIPT_LIMIT=0
PORCUPINE_QUEUE_MAX_EVENTS=100000
# Global pending original-event payload budget in bytes, separate from SQLite disk overhead.
PORCUPINE_QUEUE_MAX_BYTES=268435456
# Exact browser origins allowed for ingestion; empty disables cross-origin browser ingestion.
PORCUPINE_ALLOWED_ORIGINS=

# Only IPs/CIDRs of controlled reverse proxies; empty ignores forwarded headers.
PORCUPINE_TRUSTED_PROXIES=

# Optional ClickHouse backend. Leave URL empty for the default local DuckLake backend.
PORCUPINE_CLICKHOUSE_URL=
PORCUPINE_CLICKHOUSE_DATABASE=porcupine
PORCUPINE_CLICKHOUSE_USER=porcupine_admin
# Required only with compose.clickhouse.yaml. Generate a private random secret.
PORCUPINE_CLICKHOUSE_PASSWORD=

# Operator-only native cold storage. Empty policy keeps the existing deployment policy.
# ClickHouse only: add compose.clickhouse.yaml and compose.s3.yaml after configuring its S3 disk.
PORCUPINE_CLICKHOUSE_STORAGE_POLICY=
PORCUPINE_HOT_STORAGE_DAYS=30
PORCUPINE_CLICKHOUSE_COLD_VOLUME=cold

# Enable project webhook and S3 pipelines with a stable key (openssl rand -base64 32).
# Save this key separately from database backups. Leave empty to disable pipelines.
PORCUPINE_PIPELINE_KEY=
# Optional comma-separated S3-compatible origins. AWS S3 works without this list.
PORCUPINE_PIPELINE_S3_ENDPOINTS=

# Optional human sign-in. See docs/connect-your-team.md and docs/email-transport.md.
# Uncomment when using the OAuth + email Compose overlays.
# PORCUPINE_OAUTH_ISSUER=https://analytics.example.com
# PORCUPINE_SMTP_HOST=smtp.example.com
# PORCUPINE_SMTP_FROM=analytics@example.com
# PORCUPINE_SMTP_USERNAME=porcupine
# PORCUPINE_SMTP_PASSWORD_FILE=/etc/porcupine/secrets/smtp-password
# PORCUPINE_ADMIN_EMAIL=operator@example.com
